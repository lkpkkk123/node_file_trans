{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "调试 TCP 服务器",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "program": "${workspaceFolder}/tcp-server-fixed.js",
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "调试 TCP 客户端",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "program": "${workspaceFolder}/tcp-client.js",
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "启动程序 (index.js)",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "program": "${workspaceFolder}/index.js",
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "调试当前文件",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "program": "${file}",
      "console": "integratedTerminal"
    }
  ]
}
